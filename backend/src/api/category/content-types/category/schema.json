{
  "kind": "collectionType",
  "collectionName": "categories",
  "info": {
    "singularName": "category",
    "pluralName": "categories",
    "displayName": "Category"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true,
      "maxLength": 80,
      "column": {
        "unique": true
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true,
      "column": {
        "unique": true
      }
    },
    "description": {
      "type": "text",
      "maxLength": 500
    },
    "discussions": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::discussion.discussion",
      "mappedBy": "category"
    }
  }
}
